            srcset="/images/blog/srcset/december-3-in-music-history-runs-400w.jpg 400w, /images/blog/srcset/december-3-in-music-history-runs-800w.jpg 800w, /images/blog/december-3-in-music-history-runs-1200w.jpg 1200w"
            sizes="(max-width: 700px) 100vw, 800px"
